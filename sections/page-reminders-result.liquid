<div class='tw-py-[60px] tw-font-public-sans'>
  <div class='tw-text-center tw-mx-auto tw-max-w-[850px] tw-px-[28px]'>
    <div id='reminders-result'>
      {% style %}
        .sealsubs-target-element {
          display: none;
        }
      {% endstyle %}

      <div class='tw-pb-[60px] tw--mx-[40px]'>
        <h5 class='tw-text-primary-text tw-text-[2rem]'>
          Your FREE REMINDERS are set. Before we finish, would you like to order a Yahrzeit Box?
        </h5>
      </div>
      <div class='tw-grid tw-grid-cols-2 tw--mx-[80px]'>
        <div class='tw-bg-primary-light'></div>
        <div class='tw-border tw-border-primary-light tw-bg-primary tw-text-white tw-px-[16px] tw-py-[20px]'>
          <div class='tw-underline'>What’s Inside</div>
          <br>
          <div class='tw-underline'>Every Year You Will Recieve 1 Box + Free Reminders</div>
          <div>- <span class='notification-count'></span> Candles + Matchbook</div>
          <div data-id='tishrei_1_date_of_passing'>- 30 Day Reminders</div>
          <div data-id='prior_to_the_fast_beginning_on_yom_kippur'>- 3 Day Reminder</div>
          <div data-id='shemini_atzeret'>- Shemini Atzeret Info</div>
          <div data-id='passover'>- Day Of Reminder w/ Sundown Time</div>
          <div data-id='shavuot'>- 1 Hour Before Sundown Reminder</div>
          <div>- Prayer Card</div>
          <div>- Free Shipping</div>
        </div>
      </div>
      <h2 class='tw-text-[44px] md:tw-text-[40px] tw-py-3 tw-font-semibold tw-text-primary tw-pb-[32px]'>
        Everything You Need, Delivered to Your Door! <br>
        10% Of Every Purchase Goes to Israel.
      </h2>
      <div id='reminder_product_form_container'>
        {% form 'product', section.settings.reminder_product %}
          <input
            type='hidden'
            name='id'
            value='{{ section.settings.reminder_product.selected_or_first_available_variant.id }}'
          >
          <input
            type='hidden'
            name='quantity'
            value='1'
          >
        {% endform %}
      </div>
      <div id='candle1_product_form_container'>
        {% form 'product', section.settings.candle1_product %}
          <input
            type='hidden'
            name='id'
            value='{{ section.settings.candle1_product.selected_or_first_available_variant.id }}'
          >
          <input
            type='hidden'
            name='quantity'
            value='1'
          >
        {% endform %}
      </div>
      <div id='candle2_product_form_container'>
        {% form 'product', section.settings.candle2_product %}
          <input
            type='hidden'
            name='id'
            value='{{ section.settings.candle2_product.selected_or_first_available_variant.id }}'
          >
          <input
            type='hidden'
            name='quantity'
            value='1'
          >
        {% endform %}
      </div>
      <div id='candle3_product_form_container'>
        {% form 'product', section.settings.candle3_product %}
          <input
            type='hidden'
            name='id'
            value='{{ section.settings.candle3_product.selected_or_first_available_variant.id }}'
          >
          <input
            type='hidden'
            name='quantity'
            value='1'
          >
        {% endform %}
      </div>
      <div id='candle4_product_form_container'>
        {% form 'product', section.settings.candle4_product %}
          <input
            type='hidden'
            name='id'
            value='{{ section.settings.candle4_product.selected_or_first_available_variant.id }}'
          >
          <input
            type='hidden'
            name='quantity'
            value='1'
          >
        {% endform %}
      </div>
      <div id='candle5_product_form_container'>
        {% form 'product', section.settings.candle5_product %}
          <input
            type='hidden'
            name='id'
            value='{{ section.settings.candle5_product.selected_or_first_available_variant.id }}'
          >
          <input
            type='hidden'
            name='quantity'
            value='1'
          >
        {% endform %}
      </div>
      <form
        class='tw-text-primary-text tw-flex tw-flex-col tw-gap-[32px] tw-items-centper'
        id='reminders_result_form'
        method='post'
      >
        <input
          type='hidden'
          name='customerId'
          value='{{ customer.id }}'
        >
        <div class='tw-bg-primary tw-border tw-border-primary-light tw-text-primary-foreground tw-p-4'>
          <span class='notification-count'></span> Candle Pack, Reminders Included - $34.99 - Annual Subscription
        </div>
        <div class='tw-flex tw-justify-center tw-items-center'>
          <div class='tw-w-full md:tw-w-[60%] tw-text-black tw-flex tw-flex-col tw-gap-8'>
            <div class='tw-flex tw-items-center tw-gap-4'>
              <input
                type='checkbox'
                class='tw-w-[18px] tw-h-[18px] checked:tw-accent-white checked:tw-shadow-checkbox'
                id='result_tishrei_1_date_of_passing'
                checked
                name='tishrei_1_date_of_passing'
              >
              <label for='result_tishrei_1_date_of_passing'>Date of Passing</label>
            </div>
            <div class='tw-flex tw-items-center tw-gap-4'>
              <input
                type='checkbox'
                class='tw-w-[18px] tw-h-[18px] checked:tw-accent-white checked:tw-shadow-checkbox'
                id='result_prior_to_the_fast_beginning_on_yom_kippur'
                checked
                name='prior_to_the_fast_beginning_on_yom_kippur'
              >
              <label for='result_prior_to_the_fast_beginning_on_yom_kippur'
                >Prior to the Fast, Beginning on Yom Kippur</label
              >
            </div>
            <div class='tw-flex tw-items-center tw-gap-4'>
              <input
                type='checkbox'
                class='tw-w-[18px] tw-h-[18px] checked:tw-accent-white checked:tw-shadow-checkbox'
                id='result_shemini_atzeret'
                checked
                name='shemini_atzeret'
              >
              <label for='result_shemini_atzeret'>Shemini Atzeret</label>
            </div>
            <div class='tw-flex tw-items-center tw-gap-4'>
              <input
                type='checkbox'
                class='tw-w-[18px] tw-h-[18px] checked:tw-accent-white checked:tw-shadow-checkbox'
                id='result_passover'
                checked
                name='passover'
              >
              <label for='result_passover'>Passover</label>
            </div>
            <div class='tw-flex tw-items-center tw-gap-4'>
              <input
                type='checkbox'
                class='tw-w-[18px] tw-h-[18px] checked:tw-accent-white checked:tw-shadow-checkbox'
                id='result_shavuot'
                checked
                name='shavuot'
              >
              <label for='result_shavuot'>Shavuot</label>
            </div>
          </div>
        </div>
        <div class='tw-flex tw-flex-col tw-gap-[20px] tw-pt-[32px] tw-font-bold reminders-result-action'>
          <button
            type='button'
            class='tw-w-[370px] tw-py-[14px] tw-bg-[#D6D2C8] tw-border tw-border-[#8E9B7D] tw-text-black tw-mx-auto'
          >
            ADD MY BOX
          </button>
          <button
            type='button'
            class='tw-w-[370px] tw-py-[14px] tw-bg-[#D6D2C8] tw-border tw-border-[#8E9B7D] tw-text-black tw-mx-auto'
            data-reminders-only
          >
            SKIP FOR NOW, REMINDERS ONLY
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Reminders Result",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "product",
      "id": "candle1_product",
      "label": "Candle1 Product"
    },
    {
      "type": "product",
      "id": "candle2_product",
      "label": "Candle2 Product"
    },
    {
      "type": "product",
      "id": "candle3_product",
      "label": "Candle3 Product"
    },
    {
      "type": "product",
      "id": "candle4_product",
      "label": "Candle4 Product"
    },
    {
      "type": "product",
      "id": "candle5_product",
      "label": "Candle5 Product"
    },
    {
      "type": "product",
      "id": "reminder_product",
      "label": "Reminder Product"
    }
  ],
  "presets": [
    {
      "name": "Reminders Result"
    }
  ]
}
{% endschema %}
